{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    // Maintain (not remove) the SHA pins on GitHub Actions: Renovate updates
    // the digest and keeps the "# vX.Y.Z" comment in sync. This is the
    // OpenSSF-recommended posture — immune to tag-moving attacks
    // (tj-actions/changed-files, 2025) while staying current via PRs.
    "helpers:pinGitHubActionDigests",
    ":semanticCommits",
  ],
  timezone: "America/Denver",
  dependencyDashboard: true,
  labels: ["renovate"],

  // Aggressive flow (same posture as CharlieSu/charles.dev): no PR throttling,
  // keep branches rebased, but give upstream releases a 3-day soak before
  // PRing them — cheap insurance against compromised or yanked releases,
  // which matters for a privileged daemon. Vulnerability-driven PRs bypass
  // the soak and get labeled.
  prHourlyLimit: 0,
  prConcurrentLimit: 0,
  rebaseWhen: "behind-base-branch",
  minimumReleaseAge: "3 days",
  vulnerabilityAlerts: { labels: ["security"] },

  // Managers active for this repo (all built-in):
  //   cargo          — Cargo.toml deps + Cargo.lock
  //   github-actions — .github/workflows/* (SHA pins per the preset above)
  //   dockerfile     — digest-pinned FROM lines (updates tag+digest together)
  //   custom.regex   — the three non-Dockerfile Rust toolchain pins
  //                    (see customManagers at the bottom)
  // The built-in mise manager is disabled for `rust`, and so is the
  // github-actions manager's native `toolchain:` extraction — see the first
  // two packageRules for why.

  // Refresh transitive deps (Cargo.lock) monthly even without manifest bumps.
  lockFileMaintenance: { enabled: true, schedule: ["before 6am on the first day of the month"] },

  packageRules: [
    // ---- Rust toolchain: one dependency, one clock -------------------------
    //
    // The toolchain is pinned in four files that MUST move together, or the
    // image build breaks: Cargo.toml's `rust-version` is a hard gate (cargo
    // refuses to build when the compiler is older), so if it moves before the
    // Dockerfile's builder image, `cargo build --locked` exits 101.
    //
    // That is exactly what happened for 1.98.1 (PRs #37/#38/#40): grouping by
    // name is not enough, because a group only PRs the updates that are
    // *eligible*, and each pin was fed by a different datasource with its own
    // release timestamp:
    //
    //   mise manager           rust-version   1.98.1 @ 09-03 00:00Z
    //   github-actions manager rust-version   (duplicate of the CI pin)
    //   custom.regex           github-releases 1.98.1 @ 09-03 13:14Z
    //   dockerfile             docker          1.98.1 image @ 09-09 01:46Z
    //
    // With a 3-day soak that is three separate PRs spread over six days, the
    // enforcing pin landing days before the providing one. The fix is to make
    // every pin read the SAME datasource — the Docker image, which is the last
    // artifact to appear and the one the build actually needs. See
    // customManagers below; these rules just remove the duplicate extractions.
    {
      // The github-actions manager natively understands dtolnay/rust-toolchain
      // and extracts `toolchain:` as its own `rust` dep on the rust-version
      // datasource. That double-manages the line our custom manager owns and
      // drags it into the github-actions group as `chore` (this is PR #37).
      // The custom manager owns it; silence the built-in.
      matchManagers: ["github-actions"],
      matchDepNames: ["rust"],
      enabled: false,
    },
    {
      // Same story for mise.toml — the mise manager's rust dep rides the
      // rust-version datasource's clock, which runs ahead of the image.
      matchManagers: ["mise"],
      matchDepNames: ["rust"],
      enabled: false,
    },
    {
      // All four pins, one group, one PR.
      //
      // `fix`, not `chore`, on purpose: the builder image recompiles the
      // shipped binary. Same reasoning as the dockerfile rule below.
      groupName: "rust toolchain",
      matchManagers: ["dockerfile", "custom.regex"],
      matchPackageNames: ["rust"],
      semanticCommitType: "fix",
    },
    {
      // Anything baked into the shipped image must cut a release. ci.yaml
      // pushes to GHCR only on v* tags and nothing rebuilds on a schedule, so
      // a distroless base-image CVE fix landing as `chore` reaches nobody:
      // release-please gates on changelog *visibility* and `chore` is a hidden
      // section, so it renders nothing and skips the release PR. `fix` renders
      // and yields a patch bump.
      //
      // cargo is deliberately absent: config:recommended already types
      // [dependencies] as `fix` and [dev-dependencies] as `chore`, which is
      // exactly right — dev-deps never enter the image.
      matchManagers: ["dockerfile"],
      semanticCommitType: "fix",
    },
    {
      groupName: "github-actions",
      matchManagers: ["github-actions"],
      matchUpdateTypes: ["minor", "patch", "digest", "pinDigest"],
    },
    {
      // Auto-merge everything non-major once CI is green — the PR gauntlet
      // (fmt, clippy -D warnings, tests, cargo-audit + cargo-deny) is the
      // reviewer. Deliberately NOT platformAutomerge: this repo has no branch
      // protection, so Renovate itself waits for passing checks and merges.
      matchUpdateTypes: ["patch", "minor", "pin", "digest", "pinDigest", "lockFileMaintenance"],
      automerge: true,
    },
    {
      // Exception: Rust toolchain minors/majors wait for a human — a
      // toolchain bump rebuilds the world and can change clippy's verdicts,
      // and the four-way pin sync deserves eyes. Toolchain patches still
      // automerge via the rule above.
      matchManagers: ["dockerfile", "custom.regex"],
      matchPackageNames: ["rust"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },
  ],

  // Every toolchain pin outside the Dockerfile is managed here, and every one
  // of them points at the `docker` datasource / Docker Hub `library/rust` so
  // it shares the Dockerfile's release clock. Docker versioning keys
  // compatibility off the tag suffix, so the Dockerfile's
  // `1.98.0-slim-trixie` and these bare `1.98.0` pins each get the right
  // shape from the same lookup.
  customManagers: [
    {
      // CI pins the toolchain as an action input (dtolnay/rust-toolchain
      // `toolchain: 1.98.0`).
      customType: "regex",
      managerFilePatterns: ["/^\\.github/workflows/.+\\.ya?ml$/"],
      matchStrings: ["toolchain:\\s*(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      depNameTemplate: "rust",
      packageNameTemplate: "rust",
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
    {
      // Cargo.toml `rust-version` mirrors the pinned toolchain exactly (see
      // the note beside it) rather than stating an MSRV policy. This is the
      // pin that fails the build when it runs ahead of the builder image.
      customType: "regex",
      managerFilePatterns: ["/^Cargo\\.toml$/"],
      matchStrings: ["rust-version\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "rust",
      packageNameTemplate: "rust",
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
    {
      // mise.toml [tools] rust — the local dev toolchain.
      customType: "regex",
      managerFilePatterns: ["/^mise\\.toml$/"],
      matchStrings: ["rust\\s*=\\s*\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""],
      depNameTemplate: "rust",
      packageNameTemplate: "rust",
      datasourceTemplate: "docker",
      versioningTemplate: "docker",
    },
  ],

  // NOT managed here on purpose:
  // - deploy/base image tag — the git tree ships an unpinned template; the
  //   release artifact carries the digest pin (set by CI at tag time).
}
